{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngenieer/ux-baseline/schema/conflict.schema.json",
  "title": "ux-baseline 충돌 해소 기록",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "rules",
    "summary",
    "principle",
    "decision",
    "reason",
    "date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CF-[0-9]{3}$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]+-[0-9]{3}$"
      },
      "description": "결정이 적용되는 룰. 1개면 against 에 상대 기준을 적는다."
    },
    "summary": {
      "type": "string",
      "description": "무엇이 부딪히는가"
    },
    "principle": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "description": "적용한 우선순위: 1=법규·접근성, 2=과업 완료, 3=일관성, 4=미적 선호"
    },
    "decision": {
      "type": "string",
      "description": "결론. 각 룰 파일에도 같은 결론을 반영한다."
    },
    "reason": {
      "type": "string"
    },
    "deviates_from_priority": {
      "type": "boolean",
      "description": "상위 원칙이 이기는 기본값과 다르게 판단했으면 true (reason에 이유 필수)"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "against": {
      "type": "string",
      "description": "상대가 룰이 아닐 때의 상대 기준(예: 'KWCAG 2.2 5.4.2', '프로젝트 지침: 토큰 외 값 금지')"
    },
    "rule_changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "이 결정으로 바뀐 룰 내용 요약 (ID: 변경)"
    }
  }
}
