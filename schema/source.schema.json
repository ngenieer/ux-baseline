{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngenieer/ux-baseline/schema/source.schema.json",
  "title": "ux-baseline 출처 레지스트리",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "title": { "type": "string" },
          "type": {
            "enum": ["standard", "research", "guide", "reference_system", "experience", "preference"],
            "description": "표준 / 연구 / 가이드 / 참고 사례(디자인 시스템) / 경험 / 선호(근거 없는 관행·취향)"
          },
          "publisher": { "type": "string" },
          "version": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "verified": {
            "type": "boolean",
            "description": "원문을 직접 열어 URL·버전·내용을 확인했으면 true. false면 '확인 필요'."
          },
          "accessed": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
